{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "engine", "title", "objective", "objects", "timeline"],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "visualization" },
    "engine": { "const": "manim" },
    "title": { "$ref": "#/$defs/label" },
    "objective": { "$ref": "#/$defs/label" },
    "subject": { "$ref": "#/$defs/label" },
    "style": {
      "enum": ["automatic", "mathematical", "conceptual", "technical", "spatial", "custom"]
    },
    "difficulty": { "enum": ["introductory", "intermediate", "advanced"] },
    "background": { "$ref": "#/$defs/color" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "camera": { "$ref": "#/$defs/camera" },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "x"],
          "properties": {
            "kind": { "const": "derivative" },
            "expression": { "$ref": "#/$defs/label" },
            "x": { "$ref": "#/$defs/number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "speed", "angle", "gravity"],
          "properties": {
            "kind": { "const": "projectile" },
            "speed": { "type": "number", "minimum": 0.1, "maximum": 200 },
            "angle": { "type": "number", "minimum": 1, "maximum": 89 },
            "gravity": { "type": "number", "minimum": 0.1, "maximum": 30 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wavelength", "phase"],
          "properties": {
            "kind": { "const": "interference" },
            "wavelength": { "type": "number", "minimum": 0.5, "maximum": 10 },
            "phase": { "type": "number", "minimum": -6.284, "maximum": 6.284 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expression", "initial", "rate", "iterations"],
          "properties": {
            "kind": { "const": "gradient_descent" },
            "expression": { "$ref": "#/$defs/label" },
            "initial": { "$ref": "#/$defs/number" },
            "rate": { "type": "number", "minimum": 0.00001, "maximum": 1 },
            "iterations": { "type": "integer", "minimum": 1, "maximum": 24 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": { "const": "insertion_sort" },
            "values": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": { "type": "integer", "minimum": 0, "maximum": 99 }
            }
          }
        }
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": { "$ref": "#/$defs/object" }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seconds"],
        "properties": {
          "seconds": { "type": "number", "minimum": 0.25, "maximum": 20 },
          "narration": { "type": "string", "minLength": 1, "maxLength": 240 },
          "caption": { "$ref": "#/$defs/label" },
          "camera": { "$ref": "#/$defs/camera" },
          "animations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "$ref": "#/$defs/animation" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 180 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "number": { "type": "number", "minimum": -100000, "maximum": 100000 },
    "coord": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": -7, "maximum": 7 }
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/number" }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phi", "theta"],
      "properties": {
        "phi": { "type": "number", "minimum": 0, "maximum": 180 },
        "theta": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "text",
            "equation",
            "dot",
            "line",
            "arrow",
            "circle",
            "rectangle",
            "polygon",
            "axes",
            "plane",
            "graph",
            "curve",
            "samples",
            "array",
            "axes3d",
            "surface",
            "sphere",
            "samples3d",
            "modelValue"
          ]
        },
        "at": { "$ref": "#/$defs/coord" },
        "color": { "$ref": "#/$defs/color" },
        "opacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "size": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "Canvas units for geometry. For text, equation and modelValue use Manim font size divided by 10: 36 → 3.6, 18 → 1.8. Never put a raw font size into size."
        },
        "height": { "type": "number", "minimum": 0.1, "maximum": 6 },
        "text": { "$ref": "#/$defs/label" },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/coord" }
        },
        "axes": { "$ref": "#/$defs/id" },
        "xRange": { "$ref": "#/$defs/range" },
        "yRange": { "$ref": "#/$defs/range" },
        "expression": { "$ref": "#/$defs/label" },
        "yExpression": { "$ref": "#/$defs/label" },
        "source": {
          "enum": [
            "function",
            "tangent",
            "trajectory",
            "waveA",
            "waveB",
            "sum",
            "iterations",
            "lossSurface"
          ]
        },
        "index": { "type": "integer", "minimum": 0, "maximum": 24 },
        "component": { "enum": ["x", "y"] },
        "zRange": { "$ref": "#/$defs/range" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "object"],
      "properties": {
        "op": {
          "enum": [
            "create",
            "write",
            "fadeIn",
            "fadeOut",
            "indicate",
            "move",
            "rotate",
            "scale",
            "replace",
            "follow"
          ]
        },
        "object": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/coord" },
        "value": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    }
  },
  "x-contract": {
    "owned": ["version", "type", "engine"],
    "limits": {
      "operations": 96,
      "complexity": 85,
      "axisIntervals": 40,
      "verticalCanvas": 3.8
    },
    "objectAliases": {
      "Text": "text",
      "MathTex": "equation",
      "Dot": "dot",
      "Line": "line",
      "Arrow": "arrow",
      "Circle": "circle",
      "Rectangle": "rectangle",
      "Polygon": "polygon",
      "Axes": "axes",
      "NumberPlane": "plane",
      "ThreeDAxes": "axes3d",
      "Sphere": "sphere"
    },
    "objects": {
      "text": {
        "fields": ["text"],
        "required": ["text"],
        "size": "font scale"
      },
      "equation": {
        "fields": ["text"],
        "required": ["text"],
        "size": "font scale",
        "hint": "Allowlisted TeX without delimiters or wrappers."
      },
      "dot": {
        "fields": [],
        "size": "radius"
      },
      "circle": {
        "fields": [],
        "size": "radius"
      },
      "sphere": {
        "fields": [],
        "size": "radius"
      },
      "line": {
        "fields": ["points"],
        "required": ["points"],
        "hint": "Two distinct endpoints."
      },
      "arrow": {
        "fields": ["points"],
        "required": ["points"],
        "hint": "Two distinct endpoints."
      },
      "polygon": {
        "fields": ["points"],
        "required": ["points"],
        "hint": "At least three distinct vertices."
      },
      "rectangle": {
        "fields": ["height"],
        "size": "width"
      },
      "axes": {
        "fields": ["xRange", "yRange", "height"],
        "size": "x-axis length"
      },
      "plane": {
        "fields": ["xRange", "yRange", "height"],
        "size": "x-axis length"
      },
      "axes3d": {
        "fields": ["xRange", "yRange", "zRange", "height"],
        "size": "x-axis length"
      },
      "graph": {
        "fields": ["axes", "xRange", "source", "expression"],
        "required": ["axes"],
        "hint": "Earlier axes or plane. Exactly one of source or expression."
      },
      "curve": {
        "fields": ["axes", "xRange", "expression", "yExpression"],
        "required": ["axes", "expression", "yExpression"],
        "hint": "Earlier axes or plane. Both expressions use x as the parameter."
      },
      "samples": {
        "fields": ["axes", "source", "index"],
        "required": ["axes", "source"],
        "hint": "Earlier axes or plane. Omit index for all samples."
      },
      "samples3d": {
        "fields": ["axes", "source", "index"],
        "required": ["axes", "source"],
        "hint": "Earlier axes3d, source iterations, y=0 slice."
      },
      "surface": {
        "fields": ["axes", "xRange", "yRange", "source", "expression"],
        "required": ["axes"],
        "hint": "Earlier axes3d. Exactly one of lossSurface source or an expression in x and y."
      },
      "array": {
        "fields": ["index"],
        "hint": "Insertion sort state. Index defaults to zero."
      },
      "modelValue": {
        "fields": ["text", "source", "index", "component"],
        "required": ["source", "component"],
        "size": "font scale",
        "hint": "Text is an optional prefix for a computed sample value."
      }
    },
    "animationArguments": {
      "create": null,
      "write": null,
      "fadeIn": null,
      "fadeOut": null,
      "indicate": null,
      "move": "to",
      "rotate": "value",
      "scale": "value",
      "replace": "target",
      "follow": "target"
    },
    "scaleRange": [0.2, 3],
    "modelHints": {
      "derivative": "function and tangent graphs, tangent sample.",
      "projectile": "trajectory graph and samples. SI units, angle in degrees, level ground, no drag. Omit graph xRange for full launch-to-landing domain.",
      "interference": "waveA, waveB and sum graphs. Phase in radians, unit amplitude.",
      "gradient_descent": "function graph, iterations samples and lossSurface f(x)+y^2.",
      "insertion_sort": "array states after each insertion, starting at index zero."
    },
    "texCommands": [
      "frac",
      "sqrt",
      "cdot",
      "times",
      "pm",
      "sin",
      "cos",
      "tan",
      "exp",
      "log",
      "ln",
      "sum",
      "int",
      "infty",
      "pi",
      "lambda",
      "ell",
      "sigma",
      "omega",
      "varepsilon",
      "theta",
      "phi",
      "Delta",
      "delta",
      "alpha",
      "beta",
      "gamma",
      "partial",
      "nabla",
      "le",
      "ge",
      "approx",
      "neq",
      "left",
      "right",
      "mathbf",
      "mathrm",
      "vec",
      "overline"
    ],
    "expressionFunctions": ["sin", "cos", "exp", "sqrt", "log", "tan", "sinc"],
    "expressionHint": "sinc(t) means sin(t)/t, with sinc(0)=1. Use radians for the trigonometric arguments."
  }
}
